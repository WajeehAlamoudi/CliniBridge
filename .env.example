OPENROUTER_API_KEY=your_openrouter_api_key_here

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=CliniBridge

CHAT_AGENT_DEFAULT_MODEL=gpt_4_1

TRIAGE_AGENT_MODEL=gpt_4_1
TRIAGE_MAX_TOOL_USE=13
TRIAGE_MAX_TOKENS=900
TRIAGE_JSON_MODE=true
TRIAGE_TEMPERATURE=0.1

EHR_AGENT_MODEL=gpt_4_1
EHR_MAX_TOOL_USE=5
EHR_MAX_TOKENS=900
EHR_JSON_MODE=true
EHR_TEMPERATURE=0.0

ANAMNESIS_AGENT_MODEL=gpt_4_1
ANAMNESIS_MAX_TOOL_USE=5
ANAMNESIS_MAX_TOKENS=900
ANAMNESIS_JSON_MODE=true
ANAMNESIS_TEMPERATURE=0.0

SYNTHESIS_AGENT_MODEL=gpt_4_1
SYNTHESIS_MAX_TOOL_USE=5
SYNTHESIS_MAX_TOKENS=2000
SYNTHESIS_JSON_MODE=true
SYNTHESIS_TEMPERATURE=0.2
